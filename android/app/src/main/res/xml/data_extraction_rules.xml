<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" отключает только облачный бэкап, а перенос
     на новое устройство (device-transfer) продолжает копировать данные.
     Исключаем всё: токены зашифрованы ключом Keystore, который не переносится,
     а локальная БД без сессии дала бы чужие данные на новом устройстве. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
